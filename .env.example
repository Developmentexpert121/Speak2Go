# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values:   cp .env.example .env
#
# .env is gitignored and must STAY that way — it holds live, billable API keys
# and a salt that student identifiers are derived from. Never commit it.
# ---------------------------------------------------------------------------

# --- Required: the two external services the pipeline calls -----------------

# Deepgram — speech-to-text (nova-2). Without this, no run can start.
# Key from https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=your_deepgram_key_here

# OpenAI — the rubric scoring step. Without this, no run can start.
# Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Model used for rubric scoring. Defaults to gpt-4o-mini if unset.
# The scoring call asks for strict JSON and passes a `seed`, so the model must
# support JSON mode. gpt-4o and gpt-4o-mini both do.
#
# gpt-4o-mini is a fraction of the cost and is what the current deployment
# runs on. Changing this changes grades, so re-check a few known answers
# against the rubric after switching rather than assuming it transfers.
OPENAI_MODEL=gpt-4o-mini


# --- Required for real runs: student identity ------------------------------

# Salt used to hash a student's Israeli national ID (IDNumber) into the
# anonymised student_id that spec 3.2 requires. The raw ID is never stored.
#
# Must be a long random string, and must stay CONSTANT for the life of the
# deployment: changing it re-issues every student_id and silently breaks the
# 1:1 link between a student and their past reports. Treat it like a database
# key, not like a password to be rotated on a schedule.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_ID_SALT=


# --- Optional: pulling recordings from the Speak2Go platform ---------------
#
# Leave both blank to work entirely from manual uploads. The UI stays fully
# usable and just disables its "Fetch" buttons; /api/health reports this as
# recordingsFetch:false so the front end can explain why.
#
# Audio lives in the private s2g-recordings bucket and is NOT fetchable by
# URL. The only way in is:
#   GET {SPEAK2GO_API_URL}/api/v1/upload/getRecording?userEmail=&idDetection=
# which resolves the S3 key server-side after authorising the caller.
#
# The token needs an admin or account-manager role to read across schools. A
# teacher token only reaches students sharing its SemelMosad, so most fetches
# will fail with one.
SPEAK2GO_API_URL=
SPEAK2GO_API_TOKEN=


# --- Optional: delivering the result back to Speak2Go ----------------------
#
# When a run finishes, the Report Object can be POSTed to the callbackUrl that
# was supplied when the exam was created. Both of the settings below are
# required for that to happen — the sender FAILS CLOSED, meaning a missing
# value stops the delivery rather than quietly downgrading it. A blocked or
# failed delivery never fails the exam run itself; it is recorded on the job.

# Shared secret for the HMAC-SHA256 signature. Without it nothing is sent,
# because sending an unsigned payload of student names and grades to a URL the
# caller chose is worse than not sending it at all.
#
# The receiver verifies with the same secret. Both sides must sign the RAW
# request body — a receiver that re-serialises req.body before checking will
# fail on any pretty-printed payload. server/webhook.js exports verifyRequest()
# for the receiving side to use as-is.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SIGNING_SECRET=

# Comma-separated hosts the callbackUrl is allowed to point at. Empty means no
# deliveries at all.
#
# This is the SSRF guard: callbackUrl arrives from whoever called /api/exams,
# so without an allowlist that caller could aim this server at the cloud
# metadata endpoint (169.254.169.254) or anything else on the internal network
# and have the results posted out to it.
#
# A leading "*." matches subdomains on a dot boundary and the bare domain, so
# "*.speak2go.net" covers api.speak2go.net but NOT speak2go.net.evil.com.
# https is required except on loopback, which is allowed over http for local
# integration testing.
WEBHOOK_ALLOWED_HOSTS=

# How many times to retry a failed delivery, on top of the first attempt.
# Defaults to 3, i.e. at most 4 requests, backing off 1s / 5s / 20s between
# them. Only 429 and 5xx are retried — a 400 or 401 means the request itself
# is wrong, so repeating it just repeats the error.
#
# 0 is a valid setting and means "deliver once, never retry". A non-numeric or
# negative value falls back to the default rather than silently disabling
# retries, since a typo here should not quietly turn a recoverable delivery
# into a one-shot.
WEBHOOK_MAX_RETRIES=3


# --- Optional: uploading the report HTML to S3 -----------------------------
#
# With credentials present, each report's HTML is uploaded to the client's
# bucket and the Exam Object's reportHtmlUrl points there. Without them the
# HTML is held in memory and served from this process instead, so a missing
# credential degrades the URL rather than failing the run.
#
# NOTE: these must be PROGRAMMATIC credentials (an IAM access key). An AWS
# console username and password cannot be used by the SDK.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket and region. Defaults to oral-exams-s2g in us-east-1 — note the plural
# "exams", which is the spelling in the bucket ARN the client supplied.
S3_REPORT_BUCKET=oral-exams-s2g
AWS_REGION=us-east-1

# Key prefix inside the bucket. Objects land at
#   {prefix}/{yyyy}/{mm}/{examId}/report.html
S3_REPORT_PREFIX=reports

# Objects are uploaded private, so the returned URL is a presigned one that
# expires. Raise or lower the lifetime here (seconds).
S3_URL_TTL_SECONDS=

# Set this only if the bucket is fronted by CloudFront or is public, in which
# case reportHtmlUrl becomes {base}/{key} and never expires.
S3_PUBLIC_BASE_URL=


# --- Optional: tuning and local paths --------------------------------------

# A silence longer than this (seconds) counts as a "long pause" in the speech
# metrics handed to the scoring model. Defaults to 3.
PAUSE_THRESHOLD_SECONDS=3

# Port for the local server. Defaults to 3000.
PORT=3000

# Only read by test/run_client_sample.js — the folder of client-supplied
# sample recordings to grade in bulk. Defaults to the "Simulation 2 2024
# COBE FP" folder one level above the repo.
SAMPLE_DIR=
