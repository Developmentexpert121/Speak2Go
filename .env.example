# Deepgram
DEEPGRAM_API_KEY=your_deepgram_key_here

# LLM provider (used for rubric evaluation step)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# Pipeline tuning
PAUSE_THRESHOLD_SECONDS=3

# Salt for hashing students' IDNumber into the anonymized student_id required
# by spec 3.2. Must be a long random string and must stay CONSTANT: changing it
# re-issues every student_id and breaks the 1:1 mapping with past reports.
STUDENT_ID_SALT=

# Speak2Go platform, for pulling student recordings.
# Audio lives in the private s2g-recordings bucket and is only readable through
# GET {SPEAK2GO_API_URL}/api/v1/upload/getRecording?userEmail=&idDetection=
# The token needs an admin/account-manager role to read across schools; a
# teacher token only reaches students sharing its SemelMosad.
SPEAK2GO_API_URL=
SPEAK2GO_API_TOKEN=
