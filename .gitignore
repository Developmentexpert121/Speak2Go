# Secrets — .env holds live Deepgram and OpenAI keys. Never commit it.
.env
.env.local
.env.*.local

node_modules/

# Local exam persistence (fileStore.js) — real student data, not source
data/

# Output of test/run_client_sample.js. The client's sample recordings are named
# by student e-mail whose local part is the national ID, so this file carries
# real student identifiers next to their transcripts and grades.
tests/client_sample_results*.json

# Generated report artefacts
tests/sample_report.html
tests/sample_report.pdf
tests/sample_dashboard.html
tests/sample_dashboard.pdf

# Reference data pulled from the client database
db_reference/
sample_audio/

.DS_Store
*.log

# Real-audio report: contains a real student's transcript. Never commit.
tests/real_report.html
tests/real_report.pdf
